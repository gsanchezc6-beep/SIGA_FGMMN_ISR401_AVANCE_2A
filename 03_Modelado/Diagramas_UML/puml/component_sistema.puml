@startuml component_sistema
title Diagrama de componentes · SIGA

package "Cliente" {
  [Frontend Web] as Frontend
}

package "Plataforma SIGA" {
  [API REST] as API
  [Servicio de Análisis IA] as IA
  [Servicio de Notificaciones] as Notif
  database "Base de Datos" as BD
}

package "Infraestructura de campo" {
  [Gateway IoT] as Gateway
}

package "Sistemas externos" {
  [Sistema de Horario Académico] as Horario
  [Sistema de Videovigilancia] as Video
}

Frontend --> API : HTTPS / API REST
API --> BD : lecturas, tickets, alertas,\nusuarios, reportes
API --> IA : solicitarAnalisis()
IA --> BD : consultarHistorico()
API --> Notif : enviarAlerta()
Gateway --> API : MQTT / API REST
API --> Horario : consultarHorarioVigente()
API ..> Video : integración complementaria\n(RF-06, RD-05)

@enduml
