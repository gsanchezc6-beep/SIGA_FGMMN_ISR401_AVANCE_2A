@startuml act_ticket_mantenimiento
title Flujo de actividad · Ticket de mantenimiento (CU-06 → CU-07)

start
:Usuario registra solicitud de mantenimiento;
:Sistema valida los campos obligatorios;

if (¿Campos completos?) then (sí)
    :Sistema genera ticket con ID único;
    :Sistema registra la solicitud en bitácora;

    repeat
        :Personal de Infraestructura revisa el ticket;
        :Personal de Infraestructura actualiza el estado;
        :Sistema registra el cambio en bitácora;
    repeat while (¿Ticket sigue abierto?) is (sí)
    ->no;

    :Sistema marca el ticket como cerrado;
else (no)
    :Sistema solicita completar la información;
endif

stop

@enduml
