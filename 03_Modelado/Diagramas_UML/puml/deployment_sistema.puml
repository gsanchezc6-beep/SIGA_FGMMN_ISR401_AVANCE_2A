@startuml deployment_sistema
title Diagrama de despliegue · SIGA

node "Servidor institucional / Cloud" as Servidor {
  artifact "API REST" as API
  artifact "Servicio de Análisis IA" as IA
  database "Base de Datos" as BD
  artifact "Servicio de Notificaciones" as Notif
}

node "Gateway IoT (por aula piloto)" as Gateway {
  artifact "Firmware Gateway" as FW
}

node "Sensores y controladores" as Sensores {
  component "Sensor de temperatura/humedad" as S1
  component "Sensor de ocupación" as S2
  component "Controlador de proyector" as C1
  component "Controlador de climatización" as C2
}

node "Dispositivo cliente\n(navegador web)" as Cliente {
  artifact "Frontend Web" as FE
}

S1 --> FW : lectura analógica/digital
S2 --> FW : lectura digital
C1 --> FW : estado / comando
C2 --> FW : estado / comando

FW --> API : MQTT (puerto 1883/8883)

Cliente --> API : HTTPS (puerto 443)

API --> BD : conexión interna\n(motor de BD institucional)
API --> IA : llamada interna
API --> Notif : llamada interna

note bottom of Gateway
  Un Gateway IoT por aula piloto,
  según RD-08 (implementación
  progresiva por aulas piloto).
end note

@enduml
