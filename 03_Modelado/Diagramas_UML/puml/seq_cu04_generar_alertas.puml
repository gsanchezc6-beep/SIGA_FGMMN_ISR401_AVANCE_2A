@startuml seq_cu04_generar_alertas
title CU-04 · Generar alertas por anomalías

actor "Personal de Infraestructura\ny Mantenimiento" as Tecnico
participant "SensorIoT" as Sensor
participant "GatewayIoT" as Gateway
participant "SIGA\n(API REST)" as SIGA
participant "Servicio de\nNotificaciones" as Notif

Sensor -> Gateway : enviarLectura(valor, timestamp)
Gateway -> SIGA : transmitirLectura(aula_id, valor)
activate SIGA

SIGA -> SIGA : evaluarRegla(valor)

alt lectura supera el umbral configurado
    SIGA -> SIGA : clasificarPrioridad()
    SIGA -> SIGA : crearAlerta(aula, tipo, prioridad, fecha, hora)
    SIGA -> Notif : enviarNotificacion(alerta)
    activate Notif
    Notif -> Tecnico : notificar(alerta)
    deactivate Notif
    SIGA --> Gateway : alertaRegistrada(id_alerta)
else lectura dentro de parámetros normales
    SIGA --> Gateway : sinAccion()
end

deactivate SIGA

note right of SIGA
  Si el Servicio de Notificaciones no está
  disponible, la alerta se registra como
  "pendiente de envío" (flujo alterno A2).
end note

@enduml
