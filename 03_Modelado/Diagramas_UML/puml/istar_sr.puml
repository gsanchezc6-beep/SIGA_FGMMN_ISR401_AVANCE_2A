@startuml istar_sr
title Diagrama i* de Razón Estratégica (SR) · Actor: Personal de Infraestructura y Mantenimiento

skinparam backgroundColor white
skinparam ArrowColor #444444
skinparam rectangle {
  BackgroundColor<<Boundary>> #FDFEFE
  BorderColor<<Boundary>> #444444
  FontStyle<<Boundary>> bold
}
skinparam cloud {
  BackgroundColor #D6EAF8
  BorderColor #2E86AB
}
skinparam card {
  BackgroundColor #FADBD8
  BorderColor #943126
}
skinparam rectangle {
  BackgroundColor #D5F5E3
  BorderColor #1D6B36
}
skinparam circle {
  BackgroundColor #FFF3CD
  BorderColor #444444
  FontStyle bold
}

circle "SIGA" as SIGA

rectangle "Personal de Infraestructura y Mantenimiento" <<Boundary>> as Actor {

  cloud "Reducir tiempo de\nrespuesta a fallas" as SG

  card "Consultar panel de\ncontrol (RF-07)" as T1
  card "Recibir alertas\nautomáticas (RF-08)" as T2
  card "Registrar\nmantenimiento (RF-12)" as T3

  T1 ..> SG : contribuye (+)
  T2 ..> SG : contribuye (+)
  T3 ..> SG : contribuye (+)
}

rectangle "Panel de control\ncentralizado" as R1
rectangle "Alertas\nautomáticas" as R2
rectangle "Gestión de\ntickets" as R3

T1 ..> R1 : depende de
T2 ..> R2 : depende de
T3 ..> R3 : depende de

R1 ..> SIGA
R2 ..> SIGA
R3 ..> SIGA

legend right
  |= Elemento |= Significado |
  | Nube | Softgoal del actor |
  | Card | Tarea que el actor ejecuta |
  | Rectángulo externo | Recurso provisto por SIGA |
  | Enlace punteado interno | Contribución (means-ends) |
  | Enlace punteado externo | Dependencia hacia SIGA |
endlegend

@enduml
