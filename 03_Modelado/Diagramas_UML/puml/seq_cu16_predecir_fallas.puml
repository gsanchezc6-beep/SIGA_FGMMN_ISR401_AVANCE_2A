@startuml seq_cu16_predecir_fallas
title CU-16 · Predecir fallas de equipos (RF-09, explicabilidad RNF-10)

actor "Personal de Infraestructura\ny Mantenimiento" as Tecnico
participant "SIGA\n(API REST)" as SIGA
database "Base de Datos" as BD
participant "Módulo de\nAnálisis IA" as IA

Tecnico -> SIGA : solicitarAnalisis(aula, equipo, periodo)
activate SIGA

SIGA -> BD : consultarHistorico(equipo, periodo)
activate BD
BD --> SIGA : historico(fallas, uso, consumo, mantenimientos)
deactivate BD

alt histórico suficiente (≥30 días)
    SIGA -> IA : procesarDatos(historico)
    activate IA
    IA -> IA : generarIndicadorRiesgo()
    IA -> IA : generarExplicacion()
    note right of IA
      RNF-10: explicación causal,
      ≤2 s, ≤60 palabras
    end note
    IA --> SIGA : resultado(riesgo, explicacion)
    deactivate IA
    SIGA --> Tecnico : mostrarResultado(riesgo, explicacion)
else histórico insuficiente
    SIGA --> Tecnico : mensaje("predicción no confiable")
end

deactivate SIGA

@enduml
